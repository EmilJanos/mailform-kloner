   "id": "s9",
   "kind": "html",
   "html": "<div id=\"page-zones__main-widgets__66601cf0230e5\" data-name=\"content\" class=\"widget widget--zone-widget js-widget\" data-uniqueid=\"zvanBbVIQCeDUH7\" data-parentuniqueid=\"fsrAveu6hwgIAnF\">\n        <div class=\"bk-content-text content widget__content wysihtml-editor-content\" itemscope itemtype=\"https://schema.org/WebPage\">\n      <span class=\"js-text-content content-block\" itemprop=\"mainContentOfPage\" itemscope itemtype=\"https://schema.org/WebPageElement\">\n\n                    \n\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/rep.mp4\" target=\"_blank\"><img alt=\"repjpg\" src=\"/assets/234624a82447b4aa1dda.jpg\" width=\"977\" height=\"37\"></a><br></b></div><div style=\"text-align: center;\"><b><a href=\"http://teamjesus.dk/rosti.mp3\" target=\"_blank\"><img alt=\"linerjpeg\" src=\"/assets/0c0d9703901673f36716.jpeg\" width=\"977\" height=\"18\"></a><br></b></div>\n          \n      </span>\n    </div>\n\n    \n\n</div>"
