   "id": "s3",
   "kind": "html",
   "html": "<div id=\"page-zones__main-widgets__67f67fb3e8011\" data-name=\"content\" class=\"widget widget--zone-widget js-widget\" data-uniqueid=\"1fuOgdFLGoKXFc2\" data-parentuniqueid=\"fsrAveu6hwgIAnF\">\n        <div class=\"bk-content-text content widget__content wysihtml-editor-content\" itemscope itemtype=\"https://schema.org/WebPage\">\n      <span class=\"js-text-content content-block\" itemprop=\"mainContentOfPage\" itemscope itemtype=\"https://schema.org/WebPageElement\">\n\n                    <div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"https://mailform.dk/chosen\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">The Chosen' er et crowd-finansieret filmprojekt  baseret på livet med Jesus fra Nazareth  &gt;&gt;&gt;</span></b></a></span><br></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><a href=\"https://mailform.dk/chosen\" target=\"_blank\"><img alt=\"chosentvjpg\" src=\"/assets/feecffcb126f742eda29.jpg\" width=\"987\" height=\"83\"></a><br></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://mailform.dk/jews\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Why jews don’t believe in Jesus &gt;&gt;&gt; Hvorfor jøder ikke tror på Jesus  &gt;&gt;&gt;</span></b></a>&#160; <a href=\"https://ifoundshalom.com/\" target=\"_blank\">&gt;&gt;&gt;</a><br></span></b></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><b><a href=\"https://mailform.dk/quran\" target=\"_self\"><b><span class=\"wysiwyg-font-size-12\">Who is Jesus/Isa from the Quran &gt;&gt;&gt;</span></b></a>&#160;&#160; <a href=\"https://mailform.dk/koranen\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Hvem er Jesus/Isa i koranen &gt;&gt;&gt;</span></b></a></b></span><span class=\"wysiwyg-font-size-12\"><b><br></b></span></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><b><a href=\"https://debat.verdensbilledet.dk/imam.mp4\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Imam about Jesus in the Quran &gt;&gt;&gt; Imam om Jesus i Koranen &gt;&gt;&gt;</span></b></a><br></b></span></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><b><a href=\"http://archive.mailform.dk/ravi-abraham.mp3\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Abraham about Jesus &gt;&gt;&gt;</span></b></a></b></span><span class=\"wysiwyg-font-size-12\"><b> &#160; <a href=\"http://archive.mailform.dk/ravi-only.mp3\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Did Jesus die on the cross &gt;&gt;&gt;</span></b></a></b></span><br></b></span></div>\n\n\n\n\n<div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"https://mailform.dk/nabeel\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Testimony of Nabeel Qureshi &gt;&gt;&gt;</span></b></a> &#160; <a href=\"http://archive.mailform.dk/isa.mp4\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Isa in the quran &gt;&gt;&gt;</span></b></a></span><a href=\"https://mailform.dk/nabeel\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><br></span></a></b></span></div><div style=\"text-align: center;\"><span style=\"color: rgb(255, 255, 255);\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://teamjesus.dk/raviz.mp4\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">Where we went wrong with Ravi Zacharias &gt;&gt;&gt;</span></b></a></span><br></b></span></div><div style=\"text-align: center;\"><b><a href=\"https://www.hvemerjesus.dk\" target=\"_blank\"><i><span class=\"wysiwyg-font-size-12\">Hvem er Jesus</span></i><span class=\"wysiwyg-font-size-12\">&#160; forklaret på tegnefilm &gt;&gt;&gt;</span></a><br></b></div><div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/sodogom.mp4\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Sodoma og Gomorra virkelig &gt;&gt;&gt;</b></span></a><span class=\"wysiwyg-font-size-12\"><b> <span style=\"color: rgb(255, 255, 255);\"><a href=\"http://debat.verdensbilledet.dk/sodomgm.mp4\" target=\"_blank\">&gt;&gt;&gt;</a></span><br></b></span></b></div><div style=\"text-align: center;\"><b><a href=\"https://mailform.dk/chn001\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Chinas first religion &gt;&gt;&gt;</b></span></a><span class=\"wysiwyg-font-size-12\"><b>&#160; </b></span><a href=\"https://mailform.dk/chn002\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>&gt;&gt;&gt;</b></span></a></b></div><div style=\"text-align: center;\"><b><a href=\"https://mailform.dk/kenthv\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Bibelen vs videnskab &gt;&gt;&gt;</b></span></a></b></div><div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/thebible.mp4\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>The Bible histore &gt;&gt;&gt;</b></span></a></b></div>\n\n\n\n\n\n<div style=\"text-align: center;\"><div style=\"text-align: center;\"><b><a href=\"http://mailform.dk/dnt\" target=\"_self\"><b><span class=\"wysiwyg-font-size-12\">Læs i Bibelen  &gt;&gt;&gt;</span></b></a></b></div><div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/onemore.mp4\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">One more &gt;&gt;&gt;</span></b></a></b><b><br></b></div></div>\n\n\n\n\n\n\n\n          \n      </span>\n    </div>\n\n    \n\n</div>"
  },
