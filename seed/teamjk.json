   "kind": "html",
   "html": "<div class=\"widget widget--zone-widget\" data-name=\"content\">\n  <div class=\"bk-content-text content widget__content\">\n    <span class=\"content-block\">\n<div style=\"text-align: center;\"><b><a href=\"https://mailform.dk/mlink\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\">The Missing Link &gt;&gt;&gt;</span></a></b><br><a href=\"https://verdensbilledet.dk/universet#evangeliet\" target=\"_blank\"><img alt=\"missinglinkjpeg\" src=\"https://files.builder.nu/34/41/3441970c-7bc3-4e0e-b40c-e122971fd0c0.jpeg\" width=\"1018\" height=\"123\"></a></div>\n<div style=\"text-align: center;\"><a href=\"https://mailform.dk/missinglink\"><span class=\"wysiwyg-font-size-12\"><i><b>...the missing links &gt;&gt;&gt;</b></i><img alt=\"missingjpg\" src=\"https://files.builder.nu/13/1c/131c3aa1-ed00-43d6-b5c6-8d1a0d13a4f6.jpg\" width=\"996\" height=\"184\"></span></a></div>\n    </span>\n  </div>\n</div>"
