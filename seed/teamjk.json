   "html": "<div class=\"widget widget--zone-widget\" data-name=\"content\">\n  <div class=\"bk-content-text content widget__content\">\n    <span class=\"content-block\">\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://teamjesus.dk/chosen/\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">The Chosen' er et crowd-finansieret filmprojekt baseret på livet med Jesus fra Nazareth &gt;&gt;&gt;</span></b></a></span></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://teamjesus.dk/chosen/\" target=\"_blank\"><img alt=\"chosentvjpg\" src=\"https://files.builder.nu/da/9e/da9e2e34-fbf3-4268-83b2-f963ec6d1122.jpg\" width=\"987\" height=\"83\"></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"https://m.youtube.com/watch?v=K60TAYja110&amp;list=PLH0Szn1yYNeex8AmAgAYdXQxz5YWB3y1O&amp;index=1\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">How the royal priests of Eden, Adam, Abraham, Melchizedek, Moses etc point forward to the royal priest of Jesus &gt;&gt;&gt;</span></b></a></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://mailform.dk/jews\" target=\"_blank\"><b>Why jews don’t believe in Jesus &gt;&gt;&gt; Hvorfor jøder ikke tror på Jesus &gt;&gt;&gt;</b></a>&nbsp; <a href=\"https://ifoundshalom.com/\" target=\"_blank\">&gt;&gt;&gt;</a></span></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://teamjesus.dk/isa.mp4\" target=\"_blank\">Who is Jesus/Isa from the Quran &gt;&gt;&gt;</a><a href=\"http://teamjesus.dk/isa.mp4\" target=\"_blank\">&nbsp;&nbsp; <b>Hvem er Jesus/Isa i koranen &gt;&gt;&gt;</b></a></span></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"https://debat.verdensbilledet.dk/imam.mp4\" target=\"_blank\"><b>Imam about Jesus in the Quran &gt;&gt;&gt; Imam om Jesus i Koranen &gt;&gt;&gt;</b></a></span></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://archive.mailform.dk/ravi-abraham.mp3\" target=\"_blank\"><b>Abraham about Jesus &gt;&gt;&gt;</b></a> &nbsp; <a href=\"http://archive.mailform.dk/ravi-only.mp3\" target=\"_blank\"><b>Did Jesus die on the cross &gt;&gt;&gt;</b></a></span></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\">Testimony of Nabeel Qureshi and Isa in the quran &gt;&gt;&gt;</span></b></div>\n<div style=\"text-align: center;\"><b><span class=\"wysiwyg-font-size-12\"><a href=\"http://teamjesus.dk/raviz.mp4\" target=\"_blank\"><b>Where we went wrong with Ravi Zacharias &gt;&gt;&gt;</b></a></span></b></div>\n<div style=\"text-align: center;\"><b><a href=\"https://www.hvemerjesus.dk\" target=\"_blank\"><i><span class=\"wysiwyg-font-size-12\">Hvem er Jesus</span></i><span class=\"wysiwyg-font-size-12\">&nbsp; forklaret på tegnefilm &gt;&gt;&gt;</span></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/sodogom.mp4\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Sodoma og Gomorra virkelig &gt;&gt;&gt;</b></span></a><a href=\"http://debat.verdensbilledet.dk/sodomgm.mp4\" target=\"_blank\">&gt;&gt;&gt;</a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"https://mailform.dk/chn001\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Chinas first religion &gt;&gt;&gt;</b></span></a>&nbsp; <a href=\"https://mailform.dk/chn002\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>&gt;&gt;&gt;</b></span></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/kent-1-11.mp4\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>Bibelen vs videnskab &gt;&gt;&gt;</b></span></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/thebible.mp4\" target=\"_blank\"><span class=\"wysiwyg-font-size-12\"><b>The Bible histore &gt;&gt;&gt;</b></span></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://mailform.dk/dnt\" target=\"_self\"><b><span class=\"wysiwyg-font-size-12\">Læs i Bibelen &gt;&gt;&gt;</span></b></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/onemore.mp4\" target=\"_blank\"><b><span class=\"wysiwyg-font-size-12\">One more &gt;&gt;&gt;</span></b></a></b></div>\n    </span>\n  </div>\n</div>"
