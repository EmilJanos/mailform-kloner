  {
   "id": "s7",
   "kind": "html",
   "html": "<div class=\"widget widget--zone-widget\" data-name=\"content\">\n  <div class=\"bk-content-text content widget__content\">\n    <span class=\"content-block\">\n<div style=\"text-align: center;\"><a href=\"http://teamjesus.dk/emilsv.mp3\" target=\"_blank\"><img alt=\"emilsvjpg\" src=\"https://files.builder.nu/6f/64/6f6479f8-fae3-4340-8f7a-f79a4fc5cf33.jpg\" width=\"977\" height=\"18\"></a></div>\n<div style=\"text-align: center;\"><a href=\"http://teamjesus.dk/juliesv.mp3\" target=\"_blank\"><img alt=\"juliesvjpg\" src=\"https://files.builder.nu/00/20/0020def8-1811-41a6-bec8-f2c156a9ccca.jpg\" width=\"977\" height=\"18\"></a></div>\n    </span>\n  </div>\n</div>"
