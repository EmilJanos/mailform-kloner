   "html": "<div class=\"widget widget--zone-widget\" data-name=\"responsivecolumns\">\n  <div class=\"bk-responsivecolumns responsivecolumns widget__responsivecolumns\">\n\n    <section class=\"bk-zone column columns-two-left\">\n      <div class=\"widget widget--zone-widget\" data-name=\"gallery\">\n        <div class=\"bk-gallery gallery widget__gallery\">\n          <ul class=\"gallery-list gallery__gallery-list gallery--items-6 gallery-columns-four clip--none\">\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/23/66/2366eb4d-5a45-4722-9f52-29a75265c08d.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/23/66/2366eb4d-5a45-4722-9f52-29a75265c08d.jpg\"></a></figure></li>\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/f0/97/f0979b65-2685-46e4-9982-a948e43e0426.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/f0/97/f0979b65-2685-46e4-9982-a948e43e0426.jpg\"></a></figure></li>\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/5d/c6/5dc6dede-f665-44b6-bbd8-0c585cec8e34.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/5d/c6/5dc6dede-f665-44b6-bbd8-0c585cec8e34.jpg\"></a></figure></li>\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/d0/a3/d0a36c30-697b-4fad-9c21-303642b4f3f3.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/d0/a3/d0a36c30-697b-4fad-9c21-303642b4f3f3.jpg\"></a></figure></li>\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/df/64/df64115b-1bcd-48e1-a5f8-518e565571d0.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/df/64/df64115b-1bcd-48e1-a5f8-518e565571d0.jpg\"></a></figure></li>\n            <li class=\"gallery-item gallery__gallery-item portrait\"><figure class=\"figure gallery__figure\"><a class=\"image-link gallery__image-link\" href=\"#\" style=\"background-image: url(&quot;https://files.builder.nu/d8/d6/d8d6e5e3-1adb-4cb0-a46a-279eb82d5c6c.jpg&quot;);\"><img class=\"image gallery__image\" alt=\"\" src=\"https://files.builder.nu/d8/d6/d8d6e5e3-1adb-4cb0-a46a-279eb82d5c6c.jpg\"></a></figure></li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"bk-zone column columns-two-right\">\n      <div class=\"widget widget--zone-widget\" data-name=\"contactform\">\n        <div data-mf-form=\"\"></div>\n      </div>\n    </section>\n\n  </div>\n</div>"
