  {
   "id": "s8",
   "kind": "html",
   "html": "<div class=\"widget widget--zone-widget\" data-name=\"content\">\n  <div class=\"bk-content-text content widget__content\">\n    <span class=\"content-block\">\n<div style=\"text-align: center;\"><b><a href=\"http://debat.verdensbilledet.dk/rep.mp4\" target=\"_blank\"><img alt=\"repjpg\" src=\"https://files.builder.nu/40/5f/405fea4c-f8d1-48f6-b696-2f9fac5f72ba.jpg\" width=\"977\" height=\"37\"></a></b></div>\n<div style=\"text-align: center;\"><b><a href=\"http://teamjesus.dk/rosti.mp3\" target=\"_blank\"><img alt=\"linerjpeg\" src=\"https://files.builder.nu/09/21/09213997-ac86-41b8-9922-58f1c3bcafed.jpeg\" width=\"977\" height=\"18\"></a></b></div>\n    </span>\n  </div>\n</div>"
